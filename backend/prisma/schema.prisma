generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Field names are snake_case on purpose: the API returns rows as they are
// stored, so the names here are the names the frontend sees.

enum Role {
  founder
  investor
  expert
  admin
}

// Where a person is in vetting (TEAM_DECISIONS D7). Only `approved`
// users appear to others or can see other people's profiles.
enum ApprovalStatus {
  draft
  submitted
  in_review
  needs_info
  approved
  rejected
  suspended
  banned
}

enum JourneyType {
  startup
  sme
}

enum BusinessStatus {
  idea
  informal
  registered_business_name
  limited_company
}

model User {
  id              String         @id @default(uuid(7)) @db.Uuid
  email           String         @unique
  password_hash   String
  full_name       String
  role            Role           @default(founder)
  approval_status ApprovalStatus @default(draft)
  created_at      DateTime       @default(now())

  // A Kenyan mobile number. It counts as hers only once she has typed
  // in the code sent to it.
  phone                String?   @unique
  phone_verified_at    DateTime?
  preferred_language   String    @default("en") // en | sw
  notification_channel String    @default("in_app") // in_app | sms
  // Who may ask to connect with her: anyone | verified | none.
  // "verified" means members whose phone number is verified.
  message_permission   String    @default("anyone")
  // Whether an accepted connection sees her email and phone.
  share_contact        Boolean   @default(true)

  founder_profile      FounderProfile?
  investor_profile     InvestorProfile?
  expert_profile       ExpertProfile?
  vetting_application  VettingApplication?
  // The funder record this investor maintains, if any.
  funder               Funder?
  portfolio            PortfolioEntry[]
  ventures             Venture[]
  actions_taken        AdminAction[]        @relation("admin")
  actions_received     AdminAction[]        @relation("target")
  compliance_updates   ComplianceStatus[]
  compliance_deadlines ComplianceDeadline[]
  compliance_questions ComplianceQuestion[]
  connections_sent     Connection[]         @relation("requester")
  connections_received Connection[]         @relation("addressee")
  deal_parties         DealParty[]
  deal_events          DealEvent[]
  conversations        ConversationMember[]
  messages             Message[]
  reports              MessageReport[]
  blocks_made          Block[]              @relation("blocker")
  blocks_received      Block[]              @relation("blocked")
  circles              CircleMember[]
  circle_payments      PaymentRecord[]
  circle_notes         CircleNote[]
  circle_votes         CircleVote[]
  consents             Consent[]
  phone_code           PhoneCode?
  reports_made         UserReport[]         @relation("reporter")
  office_hours_given   OfficeHour[]         @relation("expert")
  notifications        Notification[]
  office_hours_asked   OfficeHour[]         @relation("requester")
  reports_received     UserReport[]         @relation("reported")

  @@map("users")
}

// Fields follow docs/FUNDING_FLOW.md section 3.
model FounderProfile {
  id                 String         @id @default(uuid(7)) @db.Uuid
  user_id            String         @unique @db.Uuid
  journey_type       JourneyType
  business_status    BusinessStatus
  business_name      String?
  description        String
  sector             String
  county             String
  funding_amount_kes Int?
  use_of_funds       String?

  // Startup path
  stage       String?
  instruments String[]

  // SME path
  months_trading       Int?
  monthly_revenue_band String?

  // Asked on both paths. They decide which compliance items apply.
  has_employees         Boolean?
  handles_personal_data Boolean?

  // Opt-in and self-declared. Null means "not stated". Used only to check
  // eligibility for funders that require them, never to rank.
  women_owned Boolean?
  youth_owned Boolean?
  pwd_owned   Boolean?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("founder_profiles")
}

// A thing a business can have or do that a funder may require, e.g. a
// KRA PIN. The id is a readable slug so funders and profiles can refer
// to it directly.
model ComplianceItem {
  id                 String    @id
  title              String
  why                String?
  institution        String?
  documents_needed   String?
  when_to_get_help   String?
  // business: applies to a founder's business. deal: applies to a deal of `deal_type`.
  scope              String    @default("business")
  deal_type          String?
  jurisdiction_level String    @default("national") // national | county
  // Who the item applies to, e.g. {"has_employees": true}. Empty = everyone.
  applies_when       Json      @default("{}")
  recurrence         String? // annual | monthly | quarterly
  finance_act_year   Int?
  source_url         String?
  last_verified_at   DateTime?
  next_review_at     DateTime?
  // The team member responsible for keeping this item correct.
  owner              String?
  is_demo            Boolean   @default(true)

  statuses  ComplianceStatus[]
  deadlines ComplianceDeadline[]

  @@map("compliance_items")
}

// Progress on one item, for a business (entity_id = the founder's user
// id) or, later, for a deal. An item marked complete is something the
// founder already has, which is what funder readiness is checked against.
model ComplianceStatus {
  id          String   @id @default(uuid(7)) @db.Uuid
  entity_type String // business | deal
  entity_id   String   @db.Uuid
  item_id     String
  status      String // not_started | in_progress | complete
  note        String?
  updated_by  String   @db.Uuid
  updated_at  DateTime @updatedAt

  item    ComplianceItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  updater User           @relation(fields: [updated_by], references: [id], onDelete: Cascade)

  @@unique([entity_type, entity_id, item_id])
  @@map("compliance_status")
}

model ComplianceDeadline {
  id               String    @id @default(uuid(7)) @db.Uuid
  entity_type      String
  entity_id        String    @db.Uuid
  item_id          String
  due_date         DateTime
  recurrence       String?
  reminder_sent_at DateTime?
  created_by       String    @db.Uuid

  item    ComplianceItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  creator User           @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@unique([entity_type, entity_id, item_id])
  @@map("compliance_deadlines")
}

// Every question asked, with the answer given and what the founder
// thought of it, so answers can be evaluated later.
model ComplianceQuestion {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @db.Uuid
  question   String
  language   String
  answer     String
  citations  Json
  confident  Boolean
  engine     String
  feedback   String? // helpful | not_helpful
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("compliance_questions")
}

// A funder is a record built from published information, not a user.
// Format follows docs/FUNDING_FLOW.md section 5.
model Funder {
  id                  String        @id @default(uuid(7)) @db.Uuid
  name                String        @unique
  kind                String // angel | vc | accelerator | grant | government_fund | bank | sacco
  mandate_text        String
  journey_types       JourneyType[]
  sectors             String[] // empty = any sector
  stages              String[] // empty = any stage
  counties            String[] // empty = nationwide
  instruments         String[]
  ticket_min_kes      Int
  ticket_max_kes      Int
  // Compliance item ids the funder requires before it will fund.
  requirements        String[]
  // Any of women_owned, youth_owned, pwd_owned. Empty = open to all.
  eligibility         String[]
  application_fee_kes Int           @default(0)
  // Lends to or funds groups, such as a registered self-help group.
  serves_groups       Boolean       @default(false)
  deadline            DateTime?
  how_to_apply_url    String?
  source_url          String?
  last_verified_at    DateTime?
  verified_by         String?
  is_demo             Boolean       @default(true)
  created_at          DateTime      @default(now())

  // Set when an approved investor maintains this record. Null means it
  // was built by us from public information.
  claimed_by_user_id String? @unique @db.Uuid
  claimed_by         User?   @relation(fields: [claimed_by_user_id], references: [id], onDelete: SetNull)

  @@map("funders")
}

// The person behind a funder. What they fund lives on their Funder
// record, so matching always runs on records.
model InvestorProfile {
  id                   String   @id @default(uuid(7)) @db.Uuid
  user_id              String   @unique @db.Uuid
  organisation_name    String
  job_title            String?
  organisation_website String?
  bio                  String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model ExpertProfile {
  id                     String   @id @default(uuid(7)) @db.Uuid
  user_id                String   @unique @db.Uuid
  profession             String // lawyer | accountant | mentor | other
  organisation_name      String?
  // The professional register the expert says they are on, e.g. LSK.
  register_body          String?
  register_number        String?
  bio                    String
  sectors                String[]
  counties               String[]
  // What she offers, e.g. "Business registration", "eTIMS setup".
  services               String[]
  // How many office-hours sessions she will take on in a month. 0 = none.
  office_hours_per_month Int      @default(0)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("expert_profiles")
}

// What a person submits to be checked. No ID numbers or documents are
// stored: for the hackathon the identity step is a manual admin review.
model VettingApplication {
  id                   String    @id @default(uuid(7)) @db.Uuid
  user_id              String    @unique @db.Uuid
  phone                String?
  organisation_name    String?
  organisation_website String?
  statement            String?
  references           String?
  // An investor may ask to take over an existing funder record. It is
  // granted only when an admin approves the application.
  claims_funder_id     String?   @db.Uuid
  risk_level           String? // low | medium | high
  risk_signals         String[]
  submitted_at         DateTime?
  decided_at           DateTime?
  decided_by           String?   @db.Uuid
  decision_reason      String?
  // For an investor, when two admins must approve: the first to do so.
  first_approved_by    String?   @db.Uuid
  // When an approved member is next due to be looked at again, and why.
  recheck_due_at       DateTime?
  recheck_reason       String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user   User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  checks VettingCheck[]

  @@map("vetting_applications")
}

model VettingCheck {
  id             String   @id @default(uuid(7)) @db.Uuid
  application_id String   @db.Uuid
  check_type     String // identity | phone | organisation | track_record | professional_register | reference
  result         String // pass | fail
  method         String // manual | otp | provider | brs | lsk | icpak | cma | domain | reference
  checked_by     String   @db.Uuid
  checked_at     DateTime @default(now())

  application VettingApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("vetting_checks")
}

// Audit log: every admin decision, with its reason.
model AdminAction {
  id             String   @id @default(uuid(7)) @db.Uuid
  admin_id       String   @db.Uuid
  action         String
  target_user_id String   @db.Uuid
  reason         String
  created_at     DateTime @default(now())

  admin  User @relation("admin", fields: [admin_id], references: [id], onDelete: Cascade)
  target User @relation("target", fields: [target_user_id], references: [id], onDelete: Cascade)

  @@map("admin_actions")
}

// An investor's past investment (TEAM_DECISIONS D6).
model PortfolioEntry {
  id                String   @id @default(uuid(7)) @db.Uuid
  investor_id       String   @db.Uuid
  company_name      String
  sector            String
  stage             String?
  year              Int?
  instrument        String?
  amount_range      String?
  source            String // public | self_reported | platform_deal
  source_url        String?
  visibility        String   @default("public") // public | hidden
  // The company is named to others only if it agreed, or the deal is public.
  company_consented Boolean  @default(false)
  created_at        DateTime @default(now())

  // Set when the entry was created by a deal closed on FounderLink.
  deal_id String? @db.Uuid

  investor User @relation(fields: [investor_id], references: [id], onDelete: Cascade)

  @@unique([investor_id, deal_id])
  @@map("investor_portfolio")
}

// A founder's previous venture (TEAM_DECISIONS D6).
model Venture {
  id           String   @id @default(uuid(7)) @db.Uuid
  founder_id   String   @db.Uuid
  venture_name String
  sector       String
  role         String
  years        String?
  outcome      String?
  source       String // public | self_reported
  source_url   String?
  visibility   String   @default("public")
  created_at   DateTime @default(now())

  founder User @relation(fields: [founder_id], references: [id], onDelete: Cascade)

  @@map("founder_ventures")
}

// Two approved members agreeing to be in touch. A deal can only be
// opened between people with an accepted connection.
model Connection {
  id           String    @id @default(uuid(7)) @db.Uuid
  requester_id String    @db.Uuid
  addressee_id String    @db.Uuid
  status       String    @default("pending") // pending | accepted | declined
  message      String?
  created_at   DateTime  @default(now())
  responded_at DateTime?

  requester User @relation("requester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, addressee_id])
  @@map("connections")
}

// The record of a working relationship, from the first serious
// conversation to the result (TEAM_DECISIONS D4). It records what the
// parties tell it. No money moves through FounderLink.
model Deal {
  id               String    @id @default(uuid(7)) @db.Uuid
  type             String // cofounder_partnership | investment | expert_engagement | joint_venture
  title            String
  stage            String    @default("exploring")
  status           String    @default("open") // open | paused | declined
  // A move to this stage is waiting for every party to confirm.
  pending_stage    String?
  // Recorded by the parties. Self-reported, not a legal document.
  terms            Json      @default("{}")
  // The funder record the deal grew out of, if any.
  source_funder_id String?   @db.Uuid
  // The circle whose members opened the deal, if any.
  circle_id        String?   @db.Uuid
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now())
  closed_at        DateTime?

  parties      DealParty[]
  events       DealEvent[]
  milestones   DealMilestone[]
  conversation Conversation?

  @@map("deals")
}

model DealParty {
  id                  String   @id @default(uuid(7)) @db.Uuid
  deal_id             String   @db.Uuid
  user_id             String   @db.Uuid
  role                String // founder | investor | expert
  // The pending stage this party has agreed to, if any.
  confirmed_stage     String?
  // Whether this party allows the closed deal to show on track records.
  shares_track_record Boolean  @default(false)
  joined_at           DateTime @default(now())

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([deal_id, user_id])
  @@map("deal_parties")
}

// The timeline: every change to a deal, visible to every party.
model DealEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  deal_id    String   @db.Uuid
  actor_id   String   @db.Uuid
  event      String
  from_stage String?
  to_stage   String?
  note       String?
  // Whether this event has been posted to the deal room as a system message.
  announced  Boolean  @default(false)
  created_at DateTime @default(now())

  deal  Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actor_id], references: [id], onDelete: Cascade)

  @@map("deal_events")
}

model DealMilestone {
  id       String    @id @default(uuid(7)) @db.Uuid
  deal_id  String    @db.Uuid
  title    String
  due_date DateTime?
  status   String    @default("pending") // pending | done

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@map("deal_milestones")
}

// In-app messaging (TEAM_DECISIONS D2). A conversation is either
// between two connected members, or the room of a deal.
model Conversation {
  id         String   @id @default(uuid(7)) @db.Uuid
  type       String // direct | deal | circle
  deal_id    String?  @unique @db.Uuid
  circle_id  String?  @unique @db.Uuid
  // For a direct chat: the two user ids, sorted and joined, so the same
  // two people can never have two chats.
  direct_key String?  @unique
  created_at DateTime @default(now())

  deal     Deal?                @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  circle   Circle?              @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id              String    @id @default(uuid(7)) @db.Uuid
  conversation_id String    @db.Uuid
  user_id         String    @db.Uuid
  joined_at       DateTime  @default(now())
  last_read_at    DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@map("conversation_members")
}

model Message {
  id              String   @id @default(uuid(7)) @db.Uuid
  conversation_id String   @db.Uuid
  // Null for a system message, e.g. "Amina moved the deal to Terms agreed".
  sender_id       String?  @db.Uuid
  body            String
  kind            String   @default("user") // user | system
  // Set when the message looks like a request for money.
  flagged         Boolean  @default(false)
  flag_reasons    String[]
  created_at      DateTime @default(now())

  conversation Conversation    @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User?           @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  reports      MessageReport[]

  @@index([conversation_id, id])
  @@map("messages")
}

model MessageReport {
  id          String   @id @default(uuid(7)) @db.Uuid
  message_id  String   @db.Uuid
  reporter_id String   @db.Uuid
  reason      String
  created_at  DateTime @default(now())

  message  Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@unique([message_id, reporter_id])
  @@map("message_reports")
}

model Block {
  id         String   @id @default(uuid(7)) @db.Uuid
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @default(now())

  blocker User @relation("blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@map("blocks")
}

// Founder Circles (KENYA_AMENDMENTS 7). A money circle is a group of
// people who already know each other, saving towards shared goals. A
// learning circle is for advice and accountability, with no money.
//
// FounderLink keeps the circle's records. It never receives, holds or
// forwards money.
model Circle {
  id                      String   @id @default(uuid(7)) @db.Uuid
  name                    String
  description             String?
  type                    String // money | learning
  sector                  String?
  county                  String?
  // Only a learning circle can be found and joined without an invite.
  discoverable            Boolean  @default(false)
  contribution_amount_kes Int?
  contribution_frequency  String? // weekly | monthly
  registration_status     String   @default("unregistered") // unregistered | in_progress | registered
  registration_number     String?
  // The circle's own Paybill or Till number, where members pay in.
  paybill_number          String?  @unique
  created_by              String   @db.Uuid
  created_at              DateTime @default(now())

  members      CircleMember[]
  invites      CircleInvite[]
  goals        CircleGoal[]
  payments     PaymentRecord[]
  notes        CircleNote[]
  decisions    CircleDecision[]
  conversation Conversation?

  @@map("circles")
}

model CircleMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  circle_id String   @db.Uuid
  user_id   String   @db.Uuid
  role      String   @default("member") // organiser | treasurer | member
  joined_at DateTime @default(now())

  circle Circle @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([circle_id, user_id])
  @@map("circle_members")
}

model CircleInvite {
  id         String   @id @default(uuid(7)) @db.Uuid
  circle_id  String   @db.Uuid
  token      String   @unique
  created_by String   @db.Uuid
  expires_at DateTime
  // Null = any number of people may use the link until it expires.
  max_uses   Int?
  uses       Int      @default(0)
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  circle Circle @relation(fields: [circle_id], references: [id], onDelete: Cascade)

  @@map("circle_invites")
}

model CircleGoal {
  id                String    @id @default(uuid(7)) @db.Uuid
  circle_id         String    @db.Uuid
  title             String
  target_amount_kes Int?
  target_date       DateTime?
  status            String    @default("open") // open | reached | dropped
  created_at        DateTime  @default(now())

  circle   Circle          @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  payments PaymentRecord[]

  @@map("circle_goals")
}

// A contribution a member made to the circle's own account. `source`
// says how we know: typed in by the treasurer today, and later read
// from an M-Pesa statement or a Paybill confirmation.
model PaymentRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  circle_id      String   @db.Uuid
  // Null while a payment read from a statement has not been matched to a member.
  member_id      String?  @db.Uuid
  goal_id        String?  @db.Uuid
  amount_kes     Int
  paid_at        DateTime
  mpesa_receipt  String?
  source         String   @default("manual") // manual | statement | paybill_callback
  matched_status String   @default("matched") // matched | unmatched | ignored
  // For an unmatched payment: who the statement says paid, with any
  // phone number masked, so the treasurer can tell whose it is.
  payer_label    String?
  note           String?
  recorded_by    String   @db.Uuid
  recorded_at    DateTime @default(now())

  circle Circle      @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  member User?       @relation(fields: [member_id], references: [id], onDelete: Cascade)
  goal   CircleGoal? @relation(fields: [goal_id], references: [id], onDelete: SetNull)

  // The same M-Pesa receipt can never be counted twice in a circle.
  @@unique([circle_id, mpesa_receipt])
  @@map("payment_records")
}

// A group note, or the minutes of a meeting when `held_at` is set.
model CircleNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  circle_id  String    @db.Uuid
  author_id  String    @db.Uuid
  kind       String    @default("note") // note | meeting
  held_at    DateTime?
  body       String
  created_at DateTime  @default(now())

  circle Circle @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  author User   @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@map("circle_notes")
}

model CircleDecision {
  id         String    @id @default(uuid(7)) @db.Uuid
  circle_id  String    @db.Uuid
  question   String
  status     String    @default("open") // open | closed
  created_by String    @db.Uuid
  created_at DateTime  @default(now())
  closed_at  DateTime?

  circle Circle       @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  votes  CircleVote[]

  @@map("circle_decisions")
}

model CircleVote {
  id          String   @id @default(uuid(7)) @db.Uuid
  decision_id String   @db.Uuid
  user_id     String   @db.Uuid
  choice      String // yes | no | abstain
  voted_at    DateTime @default(now())

  decision CircleDecision @relation(fields: [decision_id], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([decision_id, user_id])
  @@map("circle_votes")
}

// What a person has agreed to, purpose by purpose (Data Protection Act
// 2019, KENYA_AMENDMENTS 9). Nothing is assumed: no row means no consent.
model Consent {
  id           String    @id @default(uuid(7)) @db.Uuid
  user_id      String    @db.Uuid
  purpose      String
  granted      Boolean
  granted_at   DateTime?
  withdrawn_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, purpose])
  @@map("consents")
}

// A code sent to a phone number to prove it is hers. Only a hash of the
// code is kept, and it expires.
model PhoneCode {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @unique @db.Uuid
  phone      String
  code_hash  String
  expires_at DateTime
  attempts   Int      @default(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("phone_codes")
}

// A member reporting another member, as opposed to one message.
model UserReport {
  id               String   @id @default(uuid(7)) @db.Uuid
  reporter_id      String   @db.Uuid
  reported_user_id String   @db.Uuid
  reason           String
  created_at       DateTime @default(now())

  reporter User @relation("reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported User @relation("reported", fields: [reported_user_id], references: [id], onDelete: Cascade)

  @@unique([reporter_id, reported_user_id])
  @@map("reports")
}

// A short session a member asks an expert for. Experts cap how many
// they take on each month, so helping stays a small commitment.
model OfficeHour {
  id           String    @id @default(uuid(7)) @db.Uuid
  expert_id    String    @db.Uuid
  requester_id String    @db.Uuid
  topic        String
  status       String    @default("requested") // requested | accepted | declined | done
  created_at   DateTime  @default(now())
  responded_at DateTime?

  expert    User @relation("expert", fields: [expert_id], references: [id], onDelete: Cascade)
  requester User @relation("requester", fields: [requester_id], references: [id], onDelete: Cascade)

  @@map("office_hours")
}

// Something a member should know about. It is always stored here, and
// also sent by SMS when she chose that, has a verified number and has
// agreed to be contacted.
model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  user_id         String    @db.Uuid
  type            String
  title           String
  body            String
  // Where in the app it leads, e.g. "/deals/<id>".
  link            String?
  // in_app | sms_sent | sms_failed | sms_not_configured
  delivery_status String    @default("in_app")
  read_at         DateTime?
  created_at      DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@map("notifications")
}
