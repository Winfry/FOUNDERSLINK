# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql://founderlink:founderlink@localhost:5432/founderlink

# Supabase (if used for auth/db)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=

# AI service (internal Python service called by the Node.js backend)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=

# AI
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# The LLM that writes Ask Compliance answers from the official sources (ai/README.md).
# Any provider with an OpenAI-style /chat/completions endpoint. Without a key,
# the closest official passage is quoted word for word instead.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Leave empty unless a model that thinks before answering is too slow.
# Google Gemini, free tier (tested 9 Nov: answers in 1-3 s, every fact cited):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=

# M-Pesa (Safaricom Daraja sandbox only)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# Secret in the confirmation URL: /payments/mpesa/callback/<secret>. Empty = endpoint off.
MPESA_CALLBACK_SECRET=

# SMS (sandbox)
SMS_PROVIDER_USERNAME=sandbox
SMS_PROVIDER_API_KEY=

# Identity verification provider (production only; demo uses manual admin review)
IDV_PROVIDER_API_KEY=

# Frontend → Node.js backend
API_BASE_URL=http://localhost:8000

# Email (Resend). Empty = no email is sent.
RESEND_API_KEY=
# Show codes that could not be emailed or texted on screen, for the demo.
# Never in production. Leave false on any server outside the team's reach.
SHOW_DEMO_CODES=false
# Encrypts uploaded documents on disk. 32 bytes, base64 or hex: openssl rand -base64 32
# Required in production. Never commit the real one, and never lose it: files cannot be opened without it.
UPLOAD_ENCRYPTION_KEY=
EMAIL_FROM=FoundersLink <onboarding@resend.dev>
