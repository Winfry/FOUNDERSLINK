# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql://founderlink:founderlink@localhost:5432/founderlink

# Supabase (if used for auth/db)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=

# AI service (internal Python service called by the Node.js backend)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=

# AI
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LLM_API_KEY=
LLM_MODEL=

# M-Pesa (Safaricom Daraja sandbox only)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# Secret in the confirmation URL: /payments/mpesa/callback/<secret>. Empty = endpoint off.
MPESA_CALLBACK_SECRET=

# SMS (sandbox)
SMS_PROVIDER_USERNAME=sandbox
SMS_PROVIDER_API_KEY=

# Identity verification provider (production only; demo uses manual admin review)
IDV_PROVIDER_API_KEY=

# Frontend → Node.js backend
API_BASE_URL=http://localhost:8000

# Email (Resend). Empty = no email is sent.
RESEND_API_KEY=
EMAIL_FROM=FounderLink <onboarding@resend.dev>
